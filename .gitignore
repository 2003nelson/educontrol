# ============================================================================
# EDUCONTROL - .gitignore
# ============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
*.test.js.snap
.jest-cache/

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================================
# 🔒 VARIABLES DE ENTORNO - CRÍTICO PARA SEGURIDAD
# ============================================================================
.env*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ⚠️ IMPORTANTE: Estos archivos contienen credenciales sensibles
# NUNCA los subas a GitHub, incluso si están comentados

# ============================================================================
# VERCEL
# ============================================================================
.vercel

# ============================================================================
# TYPESCRIPT
# ============================================================================
*.tsbuildinfo
next-env.d.ts

# ============================================================================
# IDEs Y EDITORES
# ============================================================================

# VSCode
.vscode/*
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/extensions.json
.vscode/settings.json
.vscode/launch.json

# WebStorm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================================================
# SISTEMA OPERATIVO
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================================================
# SUPABASE
# ============================================================================

# Supabase CLI (si lo usas)
.supabase/
supabase/.temp/

# Backups de Supabase
*.backup
*.sql.backup

# ============================================================================
# ARCHIVOS TEMPORALES Y CACHE
# ============================================================================

# Logs personalizados
logs/
*.log

# Cache
.cache/
.parcel-cache/
.turbo/

# Temporal
tmp/
temp/
*.tmp

# ============================================================================
# ARCHIVOS SENSIBLES (Adicionales)
# ============================================================================

# Certificados y llaves
*.key
*.cert
*.crt
*.p12
*.pfx

# Backups y dumps
*.sql
*.dump
*.bak

# Archivos de configuración local
config.local.js
config.local.ts

# ============================================================================
# DESARROLLO Y TESTING
# ============================================================================

# Coverage reports
coverage/
.nyc_output/

# Jest
.jest/

# Playwright
test-results/
playwright-report/

# Cypress
cypress/videos/
cypress/screenshots/

# ============================================================================
# BUILDS Y DISTRIBUCIÓN
# ============================================================================

# Storybook
storybook-static/

# Exports
exports/

# ============================================================================
# PROYECTO ESPECÍFICO - EDUCONTROL
# ============================================================================

# Documentación generada
docs/generated/

# Reportes
reportes/
*.pdf.generated

# Uploads temporales (si tienes)
uploads/temp/

# Seeds de desarrollo (si contienen datos sensibles)
# seeds/dev/*.sql

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
# 
# ⚠️ ANTES DE HACER COMMIT:
# 1. Verifica que .env.local NO esté incluido
# 2. Verifica que no haya credenciales en el código
# 3. Revisa que no haya datos sensibles
# 
# ✅ PARA COMPARTIR CONFIGURACIÓN:
# - Crea archivos .example (ej: .env.local.example)
# - Documenta las variables necesarias
# - NO incluyas valores reales
# 
# ============================================================================
